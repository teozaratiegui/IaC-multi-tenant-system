# Copy to `.env` and edit. Only `integration-test.js` reads it.
#
# The unit tests deliberately read nothing from here: their environment is the
# fixed table in `test-env.js`. A suite whose result depends on an untracked file
# is a suite that passes on one machine and fails on the next, from the same
# commit — and it did, for anyone who kept AUTO_REGISTER_TAGS=true locally.
#
# `.env` is gitignored AND excluded from the Lambda zip — it must never be
# packaged, because it holds a real API key.

# --- Integration test (npm run test:integration) ---
# The first two are required; without them the smoke test skips itself.
ACCESS_CONTROL_URL=
ACCESS_CONTROL_API_KEY=
# Optional: each one enables the checks for that endpoint.
ASSOCIATE_TAG_URL=
WEBHOOK_URL=
# Optional: enables the WhatsApp subscription-handshake check.
WHATSAPP_VERIFY_TOKEN=
