# Copy to `.env` and edit. Jest unit tests read **only** `.env` (not this file).
# Missing keys fall back to defaults in `test-env.js`.
# --- Handler unit tests ---
AWS_REGION=
API_KEY_PARAMETER_NAME=
TAGS_TABLE_NAME=
EVENTS_TABLE_NAME=
ENVIRONMENT=
# Must match mocked SSM value + x-api-key in tests (override if you want)
UNIT_TEST_API_KEY=

# --- Integration test (`npm run test:integration`) ---
ACCESS_CONTROL_URL=
ACCESS_CONTROL_API_KEY=
