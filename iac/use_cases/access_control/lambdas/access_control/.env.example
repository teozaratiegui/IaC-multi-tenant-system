# Copy to `.env` and edit. The unit tests read **only** `.env`, never this file.
# Anything left blank falls back to the defaults in `test-env.js`.
#
# `.env` is gitignored AND excluded from the Lambda zip — it must never be
# packaged, because it can hold a real API key.

# --- Handler unit tests ---
AWS_REGION=
API_KEY_PARAMETER_NAME=
TAGS_TABLE_NAME=
EVENTS_TABLE_NAME=
ENVIRONMENT=
ORG_NAME=
# Register any unknown tag as allowed. Development only; default false.
AUTO_REGISTER_TAGS=
# Collapse retried events for one tag inside this window (ms). 0 disables it.
EVENT_DEDUP_WINDOW_MS=
# Messaging. Leave every one blank to test the deployment Terraform produces with
# enable_messaging = false on the use-case root: the provider reads as `none`, the
# null messenger takes the channel's place and tag-scan works without notifying.
# The parameter names are per use case: /<org>/<env>/<use case>/<credential>.
MESSAGING_PROVIDER=
MESSAGING_TOKEN_PARAMETER_NAME=
WEBHOOK_SECRET_PARAMETER_NAME=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# How the messages to owners read. Blank uses the slug, es-AR and Buenos Aires.
ORG_DISPLAY_NAME=
MESSAGING_LOCALE=
MESSAGING_TIMEZONE=
# Must match the mocked SSM value and the x-api-key header used by the tests.
UNIT_TEST_API_KEY=

# --- Integration test (npm run test:integration) ---
# The first two are required; without them the smoke test skips itself.
ACCESS_CONTROL_URL=
ACCESS_CONTROL_API_KEY=
# Optional: each one enables the checks for that endpoint.
ASSOCIATE_TAG_URL=
WEBHOOK_URL=
