# Local .terraform directories
**/.terraform/*

# .tfstate files (state may contain sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfplan files
*.tfplan

# Lock file (optional: uncomment to ignore; many teams commit it)
# .terraform.lock.hcl

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable value files (often contain secrets or env-specific values)
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Generated / created .md files (docs created by tooling or AI)
*.md

# CLI configuration
.terraformrc
terraform.rc

# Node (for Lambda code)
node_modules/
npm-debug.log*
package-lock.json

# OS and editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Backend config with secrets (if you use local backend config with credentials)
# backend.hcl
